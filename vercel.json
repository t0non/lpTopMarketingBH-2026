{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/qualificacao",
      "destination": "/oferta/qualificacao",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
