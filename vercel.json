{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/oferta",
      "destination": "/oferta-497/index.html"
    },
    {
      "source": "/oferta/(.*)",
      "destination": "/oferta-497/$1"
    },
    {
      "source": "/qualificacao",
      "destination": "/oferta-497/qualificacao/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
